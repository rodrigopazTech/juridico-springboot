# Configuracion de Base de Datos
DB_NAME=sistema_juridico
DB_USER=usuario_local
DB_PASSWORD=cambiar_en_local
DB_PORT_EXT=5433

# Configuracion de Seguridad
# Genera una clave aleatoria de al menos 64 caracteres para cada ambiente.
JWT_SECRET=cambiar_por_clave_larga_de_64_caracteres_minimo
MIGRATION_API_KEY=cambiar_por_api_key_de_migracion

# Configuracion Web Push VAPID
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:siaj@finabien.gob.mx

# Configuracion pgAdmin
PGADMIN_EMAIL=admin@example.local
PGADMIN_PASS=cambiar_en_local

# Alta inicial de produccion: usar solo en el primer arranque y retirar despues.
SIAJ_BOOTSTRAP_ENABLED=false
SIAJ_BOOTSTRAP_ADMIN_TEMP_PASSWORD=

# Reporta al iniciar las cuentas antiguas que requieren correo obligatorio.
REPORT_USERS_WITHOUT_EMAIL=true

# Correo SMTP tradicional (mecanismo operativo anterior)
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=siaj@finabien.gob.mx
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true

# Migracion OAuth2 suspendida temporalmente
MAIL_OAUTH2_ENABLED=false
MAIL_OAUTH2_TENANT_ID=
MAIL_OAUTH2_CLIENT_ID=
MAIL_OAUTH2_CLIENT_SECRET=
MAIL_OAUTH2_SCOPE=https://outlook.office365.com/.default
